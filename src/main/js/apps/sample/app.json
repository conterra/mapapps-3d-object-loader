{
    "properties": {
        "title": "${apptitle}"
    },
    "load": {
        "bundleLocations": [
            "localbundles",
            "bundles"
        ],
        "allowedBundles": [
            "agssearch",
            "banner",
            "languagetoggler",
            "locator-store",
            "map-init",
            "map-preload-3D",
            "mapnavigation",
            "notifier",
            "parameter-url",
            "popups-default",
            "search-ui",
            "splashscreen",
            "system",
            "template-seasons",
            "templatelayout",
            "theme-autumn",
            "toc",
            "toolset",
            "dn_imprintprivacy",
            "dn_3dobjectloader"
        ],
        "i18n": [
            "bundle"
        ]
    },
    "bundles": {
        "dn_3dobjectloader": {
            "ObjectsMeshMaskManager": {
                "meshLayerId": "mesh"
            }
        },
        "agssearch": {
            "AutoStoreRegistration": {
                "componentEnabled": true
            }
        },
        "banner": {
            "BannerWidget": {
                "label": "Developer Network",
                "image": "resource('${app}:/assets/logo.svg')",
                "imageWidth": 150,
                "imagePosition": "above",
                "link": "http://conterra.github.io"
            }
        },
        "map-init": {
            "Config": {
                "basemaps": [
                    {
                        "id": "dop",
                        "title": "${map.basemaps.dop}",
                        "selected": true,
                        "basemap": {
                            "type": "WMTS",
                            "url": "https://www.wmts.nrw.de/geobasis/wmts_nw_dop/1.0.0/WMTSCapabilities.xml",
                            "serviceMode": "RESTful",
                            "activeLayer": {
                                "id": "nw_dop",
                                "tileMatrixSetId": "EPSG_25832_16"
                            },
                            "copyright": "© Geobasis NRW (dl-de/zero-2-0)"
                        }
                    }
                ],
                "map": {
                    "layers": [
                        {
                            "id": "mesh",
                            "title": "${map.mesh.title}",
                            "type": "AGS_INTEGRATEDMESH",
                            "url": "https://www.gis.nrw.de/geobasis/3D_mesh/SceneServer",
                            "copyright": "© Geobasis NRW (dl-de/zero-2-0)"
                        },
                        {
                            "id": "lod2",
                            "title": "${map.lod2.title}",
                            "type": "AGS_SCENE",
                            "visible": false,
                            "url": "https://www.gis.nrw.de/geobasis/LOD2/SceneServer",
                            "copyright": "© Geobasis NRW (dl-de/zero-2-0)"
                        }
                    ],
                    "ground": {
                        "layers": [
                            {
                                "id": "dgm1",
                                "title": "${map.dgm1.title}",
                                "type": "AGS_ELEVATION",
                                "url": "https://www.gis.nrw.de/arcgis/rest/services/geobasis/dgm1_cache/ImageServer",
                                "copyright": "© Geobasis NRW (dl-de/zero-2-0)"
                            }
                        ]
                    }
                },
                "view": {
                    "viewmode": "3D",
                    "camera": {
                        "heading": 0,
                        "tilt": 65,
                        "position": {
                            "x": 344585,
                            "y": 5675339,
                            "z": 500,
                            "spatialReference": {
                                "wkid": 25832
                            }
                        }
                    }
                }
            }
        },
        "toc": {
            "Config": {
                "showBasemaps": false,
                "showLayerLegend": true
            }
        },
        "toolset": {
            "ToolsetManager": {
                "toolsets": [
                    {
                        "id": "mapview_tools",
                        "tools": [
                            "objectLoaderToggleTool",
                            "zoomInTool",
                            "zoomOutTool",
                            "compassTool",
                            "restoreInitialViewTool"
                        ],
                        "registerWidget": {
                            "widgetRole": "mapview_tools"
                        },
                        "container": "ignore",
                        "windowType": "container",
                        "cssClass": "muted",
                        "tooltipPositions": [
                            "before",
                            "above",
                            "below",
                            "after"
                        ]
                    }
                ]
            }
        },
        "dn_imprintprivacy": {
            "ToolHandler": {
                "imprintUrls": [
                    {
                        "locale": "de",
                        "url": "https://www.conterra.de/impressum"
                    },
                    {
                        "locale": "en",
                        "url": "https://www.con-terra.com/imprint"
                    }
                ],
                "privacyUrls": [
                    {
                        "locale": "de",
                        "url": "https://www.conterra.de/datenschutzhinweise"
                    },
                    {
                        "locale": "en",
                        "url": "https://www.con-terra.com/privacy-statements"
                    }
                ],
                "toolsetDefinition": {
                    "id": "imprintprivacyToolset",
                    "tools": [
                        "imprintTool",
                        "privacyStatementsTool"
                    ],
                    "registerWidget": {
                        "widgetRole": "footer_right"
                    },
                    "container": "ignore",
                    "windowType": "container",
                    "cssClass": "showToolLabels"
                }
            }
        },
        "toolrules": {
            "ToolActiveStateManager": {
                "activateOnStartToolIds": [
                    "objectLoaderToggleTool"
                ]
            }
        }
    }
}
